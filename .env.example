# Fida Taxi server deployment environment.
# Run ./deploy/backend.sh init to create .env with generated secrets.

# Fida-Taxi is completely independent from Fida-Ride.
SERVICE_BIND_IP=127.0.0.1
DATA_BIND_IP=127.0.0.1

POSTGRES_DB=fida_taxi
POSTGRES_USER=fida_taxi
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

REDIS_PASSWORD=
REDIS_PORT=56379

NESTJS_CORE_PORT=3100
GO_TELEMETRY_PORT=8180

JWT_HS256_SECRET=
JWT_ACCESS_TTL_SECONDS=900
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=true

RIDE_BASE_FARE_RWF=1000
RIDE_PER_KM_RWF=500
DISPATCH_RADIUS_KM=5
BIDDING_TTL_SECONDS=120

# Set this after the HTTPS reverse proxy/domain for Fida-Taxi is ready.
# Example: https://taxi-api.example.com/api/v1
FIDA_API_PUBLIC_URL=
