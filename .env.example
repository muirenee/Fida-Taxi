# Fida Taxi server deployment environment.
# If ../Fida-Ride exists, deploy/backend.sh reuses that checkout and its .env.
# These settings are used only when overriding the detected backend or when no sibling backend exists.

# Optional explicit existing backend checkout. Leave empty to auto-detect ../Fida-Ride.
FIDA_BACKEND_LOCAL_DIR=
# Optional explicit backend .env. Leave empty to use <backend>/.env for an existing checkout.
FIDA_BACKEND_ENV_FILE=

# Fallback managed-backend source used only when no local Fida-Ride checkout exists.
FIDA_BACKEND_REPOSITORY=https://github.com/muirenee/Fida-Ride.git
FIDA_BACKEND_REF=main

# Keep application services private behind a reverse proxy by default.
SERVICE_BIND_IP=127.0.0.1
DATA_BIND_IP=127.0.0.1

POSTGRES_DB=fida_ride
POSTGRES_USER=fida_ride
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

NESTJS_CORE_PORT=3000
GO_TELEMETRY_PORT=8080
CORE_REDIS_DB=0
TELEMETRY_REDIS_DB=0

# These secrets are generated only for fallback managed-backend mode.
JWT_HS256_SECRET=
JWT_ACCESS_TTL_SECONDS=900
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Testing only. Production must use an OTP delivery provider and set this false.
OTP_DEV_ECHO=true
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=

# Device attestation remains disabled until Play Integrity/App Attest credentials are configured.
ATTESTATION_ENFORCEMENT_ENABLED=false
TELEMETRY_ALLOW_INSECURE_DRIVER_ID=true

RIDE_BASE_FARE_RWF=1000
RIDE_PER_KM_RWF=500
DISPATCH_RADIUS_KM=5
DISPATCH_CANDIDATE_LIMIT=100
BIDDING_TTL_SECONDS=120
BIDDING_ACCEPT_LOCK_TTL_MS=10000

# Set this after the HTTPS reverse proxy/domain is ready.
# Example: https://api.example.com/api/v1
FIDA_API_PUBLIC_URL=
